# Copie para .env e preencha. O .env está no .gitignore e nunca deve ser commitado.

# Chave de cifra do conteúdo sensível em repouso. Gere a sua com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Perder esta chave significa perder a trilha inteira: não há recuperação.
TRILHA_CHAVE=

# Limiar de ancoragem. Abaixo dele a frase é marcada como sem lastro na fonte.
# 0.70 é o calibrado em avaliar.py (F1 0,971 / recall 1,00 sobre 36 casos).
TRILHA_LIMIAR=0.70

# Caminho do banco.
TRILHA_BANCO=trilha.db

# Retenção em dias (art. 16 da LGPD). POST /expurgo apaga o que passou disso.
TRILHA_DIAS_RETENCAO=365
